# --- Salesforce External Client App (ECA) credentials ---
# Consumer Key from: Setup > External Client App Manager > (your app) > Settings > OAuth Settings
SF_CONSUMER_KEY=

# Only set this if the ECA has "Require secret for Web Server Flow" enabled.
# Leave blank to run as a public client (PKCE only) — recommended for a local CLI.
SF_CONSUMER_SECRET=

# --- Defaults ---
# platform = production org, sandbox = sandbox/scratch org.
# Can be overridden per-run with --env, or per-server in servers.json.
SF_ENV=platform

# OAuth loopback redirect. MUST exactly match a Callback URL configured on the ECA.
OAUTH_REDIRECT_URI=http://localhost:8000/callback
OAUTH_CALLBACK_PORT=8000

# Authorization server fallback (used only if RFC 9728 discovery fails).
# Use your My Domain URL for production if login.salesforce.com is not allowed,
# or https://test.salesforce.com for sandboxes.
SF_LOGIN_URL=https://login.salesforce.com

# Hard override for the OAuth authorization server. Set to your My Domain host
# (e.g. https://acme.my.salesforce.com) if discovery resolves to the wrong host.
# Leave blank to use auto-discovery.
SF_AUTH_SERVER_URL=

# --- `sf-mcp-proxy chat` (LLM agent mode) ---
# Pick a provider with --provider or SFCHAT_PROVIDER:
#   anthropic | openai | deepseek | kimi | qwen | openrouter | custom
# Default: anthropic if ANTHROPIC_API_KEY is set.
SFCHAT_PROVIDER=

# Set the key for whichever provider(s) you use. SFCHAT_API_KEY works for any.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=
SFCHAT_API_KEY=

# Optional overrides (also available as --model / --base-url):
#   ANTHROPIC_MODEL applies only to the anthropic provider.
SFCHAT_MODEL=
SFCHAT_BASE_URL=
ANTHROPIC_MODEL=

# --- Token storage ---
# If set, cached tokens in ~/.sf-mcp-proxy are AES-256-GCM encrypted with a key
# derived from this passphrase. Leave blank to store as plaintext (mode 0600).
SF_TOKEN_PASSPHRASE=
